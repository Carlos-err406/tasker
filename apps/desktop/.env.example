# Copy to .env. Baked into the main-process bundle at build time (Vite define).
# Both values are non-secret: the URL is public and the publishable key is
# designed to ship in clients (same key the mobile app uses).
TASKER_SUPABASE_URL=https://<project-ref>.supabase.co
TASKER_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
