# Copy to .env and fill in from your Supabase project.
# All must be EXPO_PUBLIC_* to be readable in the app at runtime.

# Supabase project URL (Supabase → Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase publishable/anon key (safe to ship in the client)
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
